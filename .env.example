# SAT-SA Environment Configuration Example

# PostgreSQL Configuration
POSTGRES_USER=satsa_user
POSTGRES_PASSWORD=satsa_password
POSTGRES_DB=satsa_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URL
DATABASE_URL=postgresql+psycopg://satsa_user:satsa_password@localhost:5432/satsa_db

# FastAPI Application Configuration
PROJECT_NAME=SAT-SA
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
